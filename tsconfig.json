{
    "compilerOptions": {
        "target": "ES6",
        "module": "ES6",
        "outDir": "./static/js",
        "rootDir": "./src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": ["src/**/*.ts"]
}